# Copy this file to .env and fill in your own credentials.
# Never commit the real .env file.
DUALIS_USER=s123456
DUALIS_PASSWD=replace-with-your-dualis-password
# Leave empty to fetch all results Dualis shows.
SEMESTER_ID=

# Gotify server and the token of an application created there
GOTIFY_URL=https://gotify.example.com
GOTIFY_TOKEN=replace-with-your-gotify-app-token
# Optional: 0-10, defaults to 5
GOTIFY_PRIORITY=5

# Optional: defaults to "Dualis Notifier"
AGENT_NAME=Dualis Notifier
# Optional: keep running and check every N minutes (the Docker image uses 15)
# CHECK_INTERVAL_MINUTES=15
# Optional: only check inside this local time range (daemon loop only, not a
# single cron-run); unset checks around the clock
# CHECK_WINDOW=06:00-18:00
# Optional: only check on these weekdays, Mo Di Mi Do Fr Sa So (daemon loop
# only, not a single cron-run); unset checks every day
# CHECK_DAYS=Mo-Fr
# Optional: timezone CHECK_WINDOW and CHECK_DAYS are interpreted in, defaults to UTC
# TZ=Europe/Berlin
# Optional: folder for grades.csv and grades.html, defaults to the working directory
# DATA_DIR=.
